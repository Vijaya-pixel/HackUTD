# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
BASE_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# TigerData (Timescale Cloud) — paste the service connection string from the
# Tiger Cloud console. `messages` becomes a hypertable automatically.
#   postgres://tsdbadmin:<password>@<service>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
DATABASE_URL=
# SSL is on for any non-localhost host. Tiger Cloud signs with a private CA, so point
# DATABASE_SSL_CA at apps/server/certs/timescale-ca.pem (committed) to verify the chain
# and hostname. Set DATABASE_SSL=false only for a plain local Postgres.
DATABASE_SSL_CA=./certs/timescale-ca.pem
# DATABASE_SSL=true
# DATABASE_POOL_MAX=5

# Local fallback when DATABASE_URL is empty: embedded Postgres (PGlite) on disk.
DATABASE_PATH=./data/pglite
SESSION_TTL_DAYS=30

# ── LLM ──────────────────────────────────────────────────────────────────────
# Provider: "anthropic" | "openai"
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-...

# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# ── Photon / Spectrum ─────────────────────────────────────────────────────────
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
PHOTON_WEBHOOK_SECRET=whsec_...

# ── Deep link ─────────────────────────────────────────────────────────────────
# Deep link scheme registered in the mobile app
DEEP_LINK_SCHEME=tlife

# ── Practice limits ───────────────────────────────────────────────────────────
# How many hours of no reply before a session times out (short in demo mode)
SESSION_TIMEOUT_HOURS=4
MAX_PRACTICES_PER_DAY=1

# ── Demo mode ─────────────────────────────────────────────────────────────────
DEMO_MODE=false
DEMO_SESSION_TIMEOUT_MINUTES=2
