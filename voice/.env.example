# Copy this file to .env and fill in values. Never commit .env.
# Without these, the demo still runs and shows Photon alerts as "simulated".

PORT=3000

# Photon 2.0 (Beta) project, from https://app.beta.photon.codes -> Settings
PHOTON_PROJECT_ID=pho_prj_REPLACE_ME
# API key with project:read and project:write
PHOTON_API_KEY=REPLACE_ME

# The phone number (E.164) or iMessage email that should receive alerts,
# e.g. the customer or a trusted family member.
# Shared Photon lines cannot send the first message: text your Photon line
# once from this identity (anything, e.g. "join") before the demo.
PHOTON_ALERT_RECIPIENT=+14155550123

# Postgres (Tiger Cloud / Timescale) for scam-drill users and results
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Required to enable /api/drill/* admin endpoints (send as x-admin-key header)
DRILL_ADMIN_KEY=
# Public https URL (your cloudflared tunnel) used in drill links
PUBLIC_BASE_URL=http://localhost:3000

# Temporary: only while a new Tiger Cloud service still has its self-signed cert
# DB_SSL_NO_VERIFY=true

# Spectrum (Stable, Pro plan) — real-time two-way iMessage for the scam drill
# Dashboard: https://app.photon.codes -> project Settings
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# LLM that writes each scammer reply in character (Google AI Studio key, starts with AIzaSy)
GEMINI_API_KEY=
