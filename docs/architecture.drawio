        <mxCell id="e14" value="④ start practice" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E09A00;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#E09A00;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.09;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_api" target="s_learn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="④ personal scam text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E09A00;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#E09A00;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.97;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_learn" target="s_photon"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="④ send" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E09A00;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#E09A00;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_photon" target="e_photon"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="④ iMessage with link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E09A00;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#E09A00;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="e_photon" target="u_phone"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="trap −25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E09A00;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#E09A00;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_learn" target="s_pet"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="⑤ game result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E9E5A;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#1E9E5A;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.04;exitY=1;exitDx=0;exitDy=0;entryX=0.63;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_game" target="s_pet"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B6BE4;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#2B6BE4;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_api" target="s_sse"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flows" value="&lt;b style=&quot;font-size:16px&quot;&gt;Request flows&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#E20074&quot;&gt;① Incoming call, screened by AI&lt;/b&gt;&lt;br&gt;Twilio posts the call through the tunnel. The pre-ring engine checks allow and block lists, crowd reputation, neighbor spoofing, blocked categories and Scam Block. Unknown callers get a spoken 3-question interview while their audio streams to Deepgram.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#D7263D&quot;&gt;② Hand-off with a summary&lt;/b&gt;&lt;br&gt;Gemini turns the answers into caller, company, reason, callback, red flags and a risk score. Outright fraud is refused. Everyone else is bridged to your phone with Dial while the summary card appears live in T-Life.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#7A3BFF&quot;&gt;③ In-call detection&lt;/b&gt;&lt;br&gt;Each utterance is matched against known scam scripts by vector similarity, then judged by Gemini. Fraud or AI-voice alerts appear mid-call and can notify a family guardian.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#E09A00&quot;&gt;④ Safe Signal practice text&lt;/b&gt;&lt;br&gt;A personal, believable scam text with a link goes out over iMessage. Tapping it hits /p/:token: Buddy loses 25 energy and T-Life opens on the reveal, showing the red flags and where you should have stopped.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#1E9E5A&quot;&gt;⑤ ScamShield Quest&lt;/b&gt;&lt;br&gt;Ten playable stops, each one scam situation. Results update stars, Buddy's energy and this week's T-Mobile tasks; 180 points earns a T-Mobile Tuesdays reward." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="1860" y="96" width="560" height="640" as="geometry"/></mxCell>
        <mxCell id="decisions" value="&lt;b style=&quot;font-size:16px&quot;&gt;Engineering decisions&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Fail soft.&lt;/b&gt; Every model call has a timeout and a rule-based fallback, so a slow model never drops a call or freezes the UI.&lt;br&gt;&lt;br&gt;&lt;b&gt;Structured AI output.&lt;/b&gt; Gemini answers against JSON schemas, and replies are validated before use: practice texts must contain the link and must never ask for codes or card numbers.&lt;br&gt;&lt;br&gt;&lt;b&gt;Time-series native.&lt;/b&gt; Call history is a TimescaleDB hypertable with a retention policy; stats come from a real-time continuous aggregate.&lt;br&gt;&lt;br&gt;&lt;b&gt;Vector + keyword search&lt;/b&gt; over known scam scripts with pgvector HNSW.&lt;br&gt;&lt;br&gt;&lt;b&gt;Mobile reality.&lt;/b&gt; iOS suspends Safari during a call, so the client resyncs from a call snapshot on wake; events stream over fetch so they can carry the tunnel header.&lt;br&gt;&lt;br&gt;&lt;b&gt;Multi-instance safety.&lt;/b&gt; Photon delivers every message to every server on the project; a claim row in the database guarantees one reply.&lt;br&gt;&lt;br&gt;&lt;b&gt;Privacy.&lt;/b&gt; Calls with contacts are never analyzed; practice replies are redacted before storage; Buddy sees outcomes, never content." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fontFamily=Helvetica;fillColor=#FFF8FC;strokeColor=#E20074;" vertex="1" parent="1"><mxGeometry x="1860" y="756" width="560" height="534" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b style=&quot;font-size:14px&quot;&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#E20074&quot;&gt;━━&lt;/span&gt; ① incoming call &amp;nbsp; &lt;span style=&quot;color:#D7263D&quot;&gt;━━&lt;/span&gt; ② hand-off + live UI &amp;nbsp; &lt;span style=&quot;color:#7A3BFF&quot;&gt;━━&lt;/span&gt; ③ in-call detection&lt;br&gt;&lt;span style=&quot;color:#E09A00&quot;&gt;━━&lt;/span&gt; ④ practice text + trap &amp;nbsp; &lt;span style=&quot;color:#1E9E5A&quot;&gt;━━&lt;/span&gt; ⑤ Quest &amp;nbsp; &lt;span style=&quot;color:#2B6BE4&quot;&gt;━━&lt;/span&gt; event publish&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;Stack: Node 24 · Hono · pg · ws · twilio · @google/genai · spectrum-ts · three.js r170 (CDN import map) · TigerData (TimescaleDB, pgvector) · Twilio · Deepgram · Gemini · Photon · ngrok&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#BBBBBB;" vertex="1" parent="1"><mxGeometry x="1860" y="1310" width="560" height="156" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
