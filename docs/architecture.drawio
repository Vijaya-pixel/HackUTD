<mxfile host="app.diagrams.net" agent="ScamShield architecture generator" version="24.7.17">
  <diagram id="scamshield-arch" name="ScamShield architecture">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2460" pageHeight="1500" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b style=&quot;font-size:24px;color:#E20074&quot;&gt;ScamShield in T-Life&lt;/b&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp; carrier-side scam protection, a live AI Call Screener, Safe Signal practice texts and the ScamShield Quest game, inside T-Mobile's T-Life app&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fontFamily=Helvetica;fillColor=none;strokeColor=none;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1780" height="64" as="geometry"/></mxCell>
        <mxCell id="L1" value="&lt;b style=&quot;font-size:15px&quot;&gt;People and devices&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6B6B;strokeWidth=2;opacity=60;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="1780" height="178" as="geometry"/></mxCell>
        <mxCell id="u_demo" value="&lt;b&gt;Demo / judge browser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;the same web app on localhost:8788&lt;br&gt;simulated calls for the walkthrough&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="380" height="108" as="geometry"/></mxCell>
        <mxCell id="u_family" value="&lt;b&gt;Family lines on the account&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Harsh, Marco, Grandma Rosa · protection per line&lt;br&gt;guardian alert by iMessage on high-risk calls&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="470" y="140" width="420" height="108" as="geometry"/></mxCell>
        <mxCell id="u_phone" value="&lt;b&gt;Customer's iPhone&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Phone app (real calls) · iMessage (practice texts)&lt;br&gt;Safari running the T-Life web app over the tunnel&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="960" y="140" width="440" height="108" as="geometry"/></mxCell>
        <mxCell id="u_caller" value="&lt;b&gt;Unknown or scam caller&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;any phone on the public network&lt;br&gt;dials the protected T-Mobile number&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B6B6B;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="1420" y="140" width="370" height="108" as="geometry"/></mxCell>
        <mxCell id="L2" value="&lt;b style=&quot;font-size:15px&quot;&gt;T-Life web client&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;vanilla JS, no build step, served by the API&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FCE4F1;strokeColor=#E20074;strokeWidth=2;opacity=60;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="880" height="336" as="geometry"/></mxCell>
        <mxCell id="c_buddy" value="&lt;b&gt;buddy.js · Buddy and the trap reveal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;energy and mood from server events&lt;br&gt;link-tap reveal: every red flag and the exact&lt;br&gt;message where you should have stopped&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E20074;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="70" y="350" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="c_3d" value="&lt;b&gt;buddy3d.js · three.js r170&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;procedural 3D mascot with 8 expressions&lt;br&gt;damped motion per expression, effects&lt;br&gt;one WebGL renderer reused across screens&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E20074;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="490" y="350" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="c_app" value="&lt;b&gt;app.js · T-Life shell&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Home, Learn, Benefits, Services, Account&lt;br&gt;ScamShield screens, family&lt;br&gt;live call overlay + screening card&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E20074;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="70" y="490" width="275" height="125" as="geometry"/></mxCell>
        <mxCell id="c_api" value="&lt;b&gt;api.js · transport&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;REST + server-sent events read over fetch&lt;br&gt;resync on reconnect, wake, 3 s poll&lt;br&gt;(iOS suspends Safari during calls)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E20074;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="360" y="490" width="275" height="125" as="geometry"/></mxCell>
        <mxCell id="c_game" value="&lt;b&gt;game.js · ScamShield Quest&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;cloud map, 10 stops, 6 game engines&lt;br&gt;stars, unlocks, weekly T-Mobile&lt;br&gt;tasks, 180-point reward bar&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E20074;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="650" y="490" width="255" height="125" as="geometry"/></mxCell>
        <mxCell id="L3" value="&lt;b style=&quot;font-size:15px&quot;&gt;External services: carrier and messaging&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#2B6BE4;strokeWidth=2;opacity=60;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="300" width="870" height="336" as="geometry"/></mxCell>
        <mxCell id="e_photon" value="&lt;b&gt;Photon Spectrum&lt;br&gt;(spectrum-ts SDK)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;iMessage provider on a shared line&lt;br&gt;long-lived project stream: app.messages&lt;br&gt;&lt;br&gt;outbound practice texts&lt;br&gt;guardian alerts&lt;br&gt;number check and report by text&lt;br&gt;&lt;br&gt;constraint handled: the line can only&lt;br&gt;text a number after it texts first&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6BE4;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="980" y="350" width="420" height="265" as="geometry"/></mxCell>
        <mxCell id="e_twilio" value="&lt;b&gt;Twilio Programmable Voice&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;owned +1 844 number · TwiML Say, Pause,&lt;br&gt;Redirect, Dial · signed webhooks&lt;br&gt;Media Streams (μ-law 8 kHz over WSS)&lt;br&gt;status + dial callbacks · Polly voice&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6BE4;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="1420" y="350" width="370" height="140" as="geometry"/></mxCell>
        <mxCell id="e_ngrok" value="&lt;b&gt;ngrok tunnel (HTTPS + WSS)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;public URL → localhost:8788&lt;br&gt;webhooks, media socket, the phone's browser&lt;br&gt;bypass header lets the event stream through&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6BE4;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="1420" y="510" width="370" height="105" as="geometry"/></mxCell>
        <mxCell id="L4" value="&lt;b style=&quot;font-size:15px&quot;&gt;ScamShield API · Node 24 + Hono&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;one process: REST, webhooks, WebSocket media server, event hub, Photon stream&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#E6F6EC;strokeColor=#1E9E5A;strokeWidth=2;opacity=60;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="662" width="1780" height="392" as="geometry"/></mxCell>
        <mxCell id="s_api" value="&lt;b&gt;index.js · REST API (45 routes)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;call state machine:&lt;br&gt;ringing → screening → connected → ended&lt;br&gt;snapshot for reconnecting clients&lt;br&gt;reports, lists, lines, premium&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E9E5A;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="70" y="720" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="s_sse" value="&lt;b&gt;sse.js · event hub&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;pub/sub to every open client&lt;br&gt;&lt;br&gt;call · activity · pet&lt;br&gt;learn · lists · report&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E9E5A;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="400" y="720" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="s_risk" value="&lt;b&gt;risk.js · pre-ring decision engine&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;allow list → block list → crowd reputation&lt;br&gt;→ neighbor-spoof boost → category routing&lt;br&gt;→ Scam Block at risk ≥ 80, label at ≥ 45&lt;br&gt;in-call verdicts with similar known scripts&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E9E5A;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="690" y="720" width="340" height="150" as="geometry"/></mxCell>
        <mxCell id="s_photon" value="&lt;b&gt;photon.js · iMessage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;claims each message id in the database&lt;br&gt;so only one server ever replies&lt;br&gt;routes practice replies, number checks,&lt;br&gt;reports and guardian alerts&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E9E5A;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="1050" y="720" width="330" height="150" as="geometry"/></mxCell>
        <mxCell id="s_twilio" value="&lt;b&gt;twilio.js · voice control&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;voice, status, dial and dial-status webhooks&lt;br&gt;2 s TwiML wait loop speaks each question&lt;br&gt;Dial hand-off to the subscriber&lt;br&gt;WebSocket /twilio/media feeds speech-to-text&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E9E5A;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="1400" y="720" width="390" height="150" as="geometry"/></mxCell>
        <mxCell id="s_learn" value="&lt;b&gt;learn.js · Safe Signal practice&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;personal, link-first scam texts (Gemini persona)&lt;br&gt;safety filter: never asks for PIN, code, card, SSN&lt;br&gt;PII redaction · lesson builder&lt;br&gt;/p/:token trap link → reveal in T-Life&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E9E5A;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="70" y="890" width="350" height="140" as="geometry"/></mxCell>
        <mxCell id="s_pet" value="&lt;b&gt;pet.js · Buddy and Quest economy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;energy = 40 + protections (≤ 20)&lt;br&gt;+ last 30 days of events&lt;br&gt;game results, stars, XP and level&lt;br&gt;weekly task per stop, 180-pt goal → reward&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E9E5A;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="440" y="890" width="345" height="140" as="geometry"/></mxCell>
        <mxCell id="s_llm" value="&lt;b&gt;llm.js · Gemini gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;answers against JSON response schemas&lt;br&gt;4–7 s timeout on every call&lt;br&gt;rule-based fallback classifier&lt;br&gt;when the model is slow or down&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E9E5A;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="800" y="890" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="s_screener" value="&lt;b&gt;screener.js · AI Call Screener&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;3 questions: who, why, company + callback&lt;br&gt;Gemini summary: caller, reason, red flags, risk&lt;br&gt;outright fraud is refused&lt;br&gt;everyone else rings you with the summary&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E9E5A;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="1115" y="890" width="385" height="140" as="geometry"/></mxCell>
        <mxCell id="s_stt" value="&lt;b&gt;stt.js · speech-to-text&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Deepgram streaming client&lt;br&gt;emits finished utterances&lt;br&gt;4-minute cap per call&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E9E5A;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="1515" y="890" width="275" height="140" as="geometry"/></mxCell>
        <mxCell id="L5" value="&lt;b style=&quot;font-size:15px&quot;&gt;TigerData · TimescaleDB 2.31 on Postgres 18&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:11px;color:#555&quot;&gt;pg pool over TLS · SQL migrations 001–007&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#E3F4F6;strokeColor=#0F7A87;strokeWidth=2;opacity=60;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="1780" height="210" as="geometry"/></mxCell>
        <mxCell id="d_core" value="&lt;b&gt;Core&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;accounts · lines (toggles JSONB)&lt;br&gt;numbers (crowd reputation)&lt;br&gt;list_entries · category_prefs&lt;br&gt;reports · lookups&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F7A87;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="70" y="1130" width="280" height="135" as="geometry"/></mxCell>
        <mxCell id="d_ts" value="&lt;b&gt;Time series (TimescaleDB)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;call_events hypertable + retention policy&lt;br&gt;line_daily continuous aggregate&lt;br&gt;(real time, feeds the stats)&lt;br&gt;learn_messages hypertable&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F7A87;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="365" y="1130" width="325" height="135" as="geometry"/></mxCell>
        <mxCell id="d_vec" value="&lt;b&gt;Vector search (pgvector)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;scam_scripts&lt;br&gt;1024-d embeddings&lt;br&gt;HNSW index, cosine&lt;br&gt;+ keyword fallback&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F7A87;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="705" y="1130" width="225" height="135" as="geometry"/></mxCell>
        <mxCell id="d_learn" value="&lt;b&gt;Practice&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;learn_consents&lt;br&gt;learn_sessions&lt;br&gt;learn_skills&lt;br&gt;&lt;i&gt;(learn.js)&lt;/i&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F7A87;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="970" y="1130" width="200" height="135" as="geometry"/></mxCell>
        <mxCell id="d_game" value="&lt;b&gt;Game&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;pet_events · game_progress&lt;br&gt;game_tasks · game_rewards&lt;br&gt;&lt;i&gt;(pet.js)&lt;/i&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F7A87;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="1185" y="1130" width="215" height="135" as="geometry"/></mxCell>
        <mxCell id="d_msg" value="&lt;b&gt;Messaging&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;photon_inbound&lt;br&gt;one reply per message&lt;br&gt;across servers&lt;br&gt;&lt;i&gt;(photon.js)&lt;/i&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F7A87;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="1415" y="1130" width="190" height="135" as="geometry"/></mxCell>
        <mxCell id="L6" value="&lt;b style=&quot;font-size:15px&quot;&gt;AI services&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F1E8FF;strokeColor=#7A3BFF;strokeWidth=2;opacity=60;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1316" width="1780" height="150" as="geometry"/></mxCell>
        <mxCell id="a_embed" value="&lt;b&gt;gemini-embedding-001&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;1024-dimension vectors for the&lt;br&gt;known scam-script library (seeded)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A3BFF;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="70" y="1360" width="360" height="85" as="geometry"/></mxCell>
        <mxCell id="a_polly" value="&lt;b&gt;Amazon Polly, through Twilio Say&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Polly.Matthew voice for the screener:&lt;br&gt;questions, nudges, hand-off lines&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A3BFF;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="450" y="1360" width="380" height="85" as="geometry"/></mxCell>
        <mxCell id="a_gemini" value="&lt;b&gt;Google Gemini 3.5 Flash Lite&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;via @google/genai · call verdicts · screening summaries&lt;br&gt;scammer persona turns · lesson rules · SMS replies&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A3BFF;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="845" y="1360" width="455" height="85" as="geometry"/></mxCell>
        <mxCell id="a_dg" value="&lt;b&gt;Deepgram nova-3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;live speech-to-text over WebSocket&lt;br&gt;μ-law 8 kHz straight from Twilio Media Streams&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A3BFF;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;spacing=5;" vertex="1" parent="1"><mxGeometry x="1315" y="1360" width="475" height="85" as="geometry"/></mxCell>
